# Read only with CoE5SE

# The spellpath
newspellpath "Machine Cult"

newspell "Blessing of the Omnissiah"
path "Machine Cult"
level 1
weapon 5 "Heal"
healhumanarmy

newspell "Machine Spirit's Wrath"
path "Machine Cult"
level 2
weapon 10 "Lightning Bolt"

newspell "Promethium Cleansing"
path "Machine Cult"
level 3
weapon 15 "Fireball"
slowcast
burnforest

# A ritual that teaches a spell
newritpow # Machine Cult rites
newritual "Rite of Awakening"
level 1
newspell2 "Machine Cult"

# The tech-priests' magic
selectmonster "Tech-Priest"
spellweaponbonus "Machine Cult" 1
power 0 1
selectmonster "Archmagos"
spellweaponbonus "Machine Cult" 3
power 0 1

# An item that casts a spell
newitem "Servo-Skull"
rarity 3
combatspell 1 "Machine Spirit's Wrath"

# A setting for the Archmagos's health
newsetting archmagos_strength
choice
default 0
label "Archmagos starting Hit Points"
option 0 "Normal"
optiontip 0 "He keeps the Captain's 10 HP."
option 1 "Weak (1 HP)"
optiontip 1 "He starts with Failing Augmetics: -9 HP."
option 2 "Strong (1000 HP)"
optiontip 2 "He starts with Omnissiah's Favor: +990 HP."

newitem "Failing Augmetics"
rarity 3
hp -9

newitem "Omnissiah's Favor"
rarity 3
hp 990

playerevent
+turnnbr 0
+setting archmagos_strength 1
+hasunit -2 "Archmagos"
newitem "Failing Augmetics"
endevent

playerevent
+turnnbr 0
+setting archmagos_strength 2
+hasunit -2 "Archmagos"
newitem "Omnissiah's Favor"
endevent
